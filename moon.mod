// Learn more about moon.mod configuration:
// https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "weopqrst/mooncsg"

version = "0.1.0"

repository = "https://github.com/mihujiang/mooncsg"

license = "Apache-2.0"

keywords = [ "csg", "sdf", "3d", "modeling", "mesh" ]

readme = "README.md"

preferred_target = "wasm-gc"

description = "Pure MoonBit 3D solid modeling kernel: signed distance primitives, exact CSG booleans, marching tetrahedra meshing, STL/OBJ export, no FFI."
